<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/gris_fondo"/><corners android:radius="12dp"/><stroke android:width="1dp" android:color="@color/deshabilitado"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/admin_verde_claro"/><corners android:radius="12dp"/><stroke android:width="2dp" android:color="@color/admin_verde"/></shape>
    </item>
    <item>
        <shape><solid android:color="@color/superficie"/><corners android:radius="12dp"/><stroke android:width="2dp" android:color="@color/admin_verde"/></shape>
    </item>
</selector>
