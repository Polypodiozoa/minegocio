<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include layout="@layout/barra_superior" />

    <ScrollView
android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="26dp">

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtTituloCompra"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/texto"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badgeCompra"
                        style="@style/EstadoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtFechaCompra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/texto_secundario"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtAvisoAnulada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/fondo_badge_rojo"
                    android:padding="10dp"
                    android:text="Compra anulada. Las existencias se descontaron del inventario."
                    android:textColor="@color/error"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnVerProveedor"
                    style="@style/BotonTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="start|center_vertical"
                    android:text="Proveedor" />

                <TextView
                    android:id="@+id/txtFormaPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/texto"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Productos y conceptos" />

                <LinearLayout
                    android:id="@+id/containerItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Totales" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Subtotal"
                        android:textColor="@color/texto_secundario"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/lblImpuesto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Impuesto"
                        android:textColor="@color/texto_secundario"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtImpuesto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textSize="18sp" />
                </LinearLayout>

                <View
                    style="@style/Separador"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textColor="@color/texto"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primario"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardNotas"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notas de la compra" />

                <TextView
                    android:id="@+id/txtNotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardComprobantes"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comprobantes" />

                <Button
                    android:id="@+id/btnVerComprobantes"
                    style="@style/BotonSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ver comprobantes" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCompartir"
                style="@style/BotonSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Compartir resumen de la compra" />

            <Button
                android:id="@+id/btnAnular"
                style="@style/BotonPeligro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Anular esta compra" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
