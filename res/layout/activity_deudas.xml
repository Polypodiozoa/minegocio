<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include layout="@layout/barra_superior" />

    <LinearLayout
        style="@style/Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="12dp">

        <TextView
            style="@style/TituloSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cartera de fiados" />

        <LinearLayout
            android:id="@+id/containerResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <Button
            android:id="@+id/btnTodas"
            style="@style/BotonSecundario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:text="Todas" />

        <Button
            android:id="@+id/btnVencidas"
            style="@style/BotonSecundario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:textSize="15sp"
            android:text="Vencidas" />

        <Button
            android:id="@+id/btnPorVencer"
            style="@style/BotonSecundario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:textSize="15sp"
            android:text="Por vencer" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/borde"
            android:dividerHeight="1dp"
            android:background="@color/superficie"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:cacheColorHint="@android:color/transparent" />

        <TextView
            android:id="@+id/txtVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="28dp"
            android:gravity="center"
            android:text="No hay deudas en este filtro."
            android:textColor="@color/texto_secundario"
            android:textSize="17sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:elevation="8dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btnExcel"
            style="@style/BotonSecundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exportar deudas a Excel" />
    </LinearLayout>
</LinearLayout>
