<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include layout="@layout/barra_superior" />

    <ScrollView
android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="26dp">

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/spPeriodo"
                    android:text="Período" />

                <Spinner
                    android:id="@+id/spPeriodo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/fondo_campo"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:minHeight="56dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumen del período" />

                <LinearLayout
                    android:id="@+id/containerMetricas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Ayuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="La utilidad bruta descuenta el impuesto cobrado y el costo de los productos vendidos. La utilidad neta también descuenta los gastos." />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Productos más vendidos" />

                <TextView
                    android:id="@+id/txtVacioTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No hay ventas en este período."
                    android:textColor="@color/texto_secundario"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/containerTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ventas por forma de pago" />

                <TextView
                    android:id="@+id/txtVacioFormas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No hay ventas en este período."
                    android:textColor="@color/texto_secundario"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/containerFormas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <Button
                android:id="@+id/btnExcel"
                style="@style/BotonPrimario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exportar informe del período a Excel" />

            <Button
                android:id="@+id/btnCsv"
                style="@style/BotonSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Exportar solo ventas (CSV)" />

            <Button
                android:id="@+id/btnCompartir"
                style="@style/BotonSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Compartir resumen" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
