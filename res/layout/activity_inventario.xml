<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include layout="@layout/barra_superior" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/superficie"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etBuscar"
            style="@style/Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar producto"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:drawableStart="@drawable/ic_buscar"
            android:drawablePadding="8dp"
            android:drawableTint="@color/texto_secundario"
            android:contentDescription="Buscar producto por nombre, categoría o código" />

        <Button
            android:id="@+id/btnEscanear"
            style="@style/BotonSecundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="Escanear código para buscar o agregar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTodos"
                style="@style/BotonSecundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:textSize="15sp"
                android:text="Todos" />

            <Button
                android:id="@+id/btnAgotados"
                style="@style/BotonSecundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:textSize="15sp"
                android:text="Agotados" />

            <Button
                android:id="@+id/btnBajos"
                style="@style/BotonSecundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:textSize="14sp"
                android:text="Por agotarse" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txtResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:textColor="@color/texto_secundario"
        android:textSize="15sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/borde"
            android:dividerHeight="1dp"
            android:background="@color/superficie"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:cacheColorHint="@android:color/transparent" />

        <TextView
            android:id="@+id/txtVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="28dp"
            android:gravity="center"
            android:text="Todavía no tienes productos. Agrega el primero con el botón de abajo."
            android:textColor="@color/texto_secundario"
            android:textSize="17sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:elevation="8dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btnNuevo"
            style="@style/BotonPrimario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar producto" />
    </LinearLayout>
</LinearLayout>
