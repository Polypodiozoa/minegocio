<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paga desde tu celular"
                android:textColor="@color/texto"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Escanea el QR o usa los datos de la cuenta."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/txtAvisoEjemplo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/fondo_alerta"
                android:padding="12dp"
                android:text="Tienes datos de ejemplo. Completa tu información."
                android:textColor="@color/advertencia"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnCompletarDatos"
                style="@style/BotonPrimario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Completar datos"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/contenedorModulos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/cardQr"
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/txtQrTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="QR"
                        android:textColor="@color/texto"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgQr"
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/blanco"
                        android:contentDescription="Código QR"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_qr" />

                    <TextView
                        android:id="@+id/txtQrAyuda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Toca el QR para verlo en grande"
                        android:textColor="@color/texto_secundario"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardLlave"
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/TituloSeccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="Llave Bre-B" />

                    <TextView
                        android:id="@+id/txtLlave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textIsSelectable="true"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Ayuda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Es el identificador que le dictas a quien te paga." />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardCuenta"
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/TituloSeccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="Número de cuenta" />

                    <TextView
                        android:id="@+id/txtCuenta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textIsSelectable="true"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtBanco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/texto"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/txtTitular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/texto_secundario"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Ayuda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Si el QR o la llave Bre-B fallan, comparte este número de cuenta." />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardAyuda"
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/TituloSeccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cómo pagar" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Escanea el QR con la app del banco o billetera.\n2. Si no puedes escanear, dicta la llave Bre-B.\n3. Si algo falla, comparte el número de cuenta.\n4. Confirma el valor y guarda el comprobante."
                        android:textColor="@color/texto"
                        android:textSize="17sp"
                        android:lineSpacingExtra="5dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtSinModulos"
                style="@style/Ayuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="No hay módulos visibles. Personaliza el mostrador desde Ajustes."
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
