<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include layout="@layout/barra_superior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paga desde tu celular"
                android:textColor="@color/texto"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Escanea el QR o usa los datos de la cuenta. Pregunta si necesitas ayuda."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/txtQrTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Escanea el QR de Bre-B"
                    android:textColor="@color/texto"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgQr"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/blanco"
                    android:contentDescription="Código QR para pagar"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_qr" />

                <TextView
                    android:id="@+id/txtQrAyuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Toca el QR para verlo en grande"
                    android:textColor="@color/texto_secundario"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="Llave Bre-B" />

                <TextView
                    android:id="@+id/txtEjemploLlave"
                    style="@style/EtiquetaEjemplo"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtLlave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textIsSelectable="true"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Ayuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Es el identificador que le dictas a quien te paga." />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="Número de cuenta" />

                <TextView
                    android:id="@+id/txtEjemploCuenta"
                    style="@style/EtiquetaEjemplo"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textIsSelectable="true"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEjemploBanco"
                    style="@style/EtiquetaEjemplo"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtBanco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/texto"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/txtEjemploTitular"
                    style="@style/EtiquetaEjemplo"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtTitular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/texto_secundario"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Métodos disponibles" />

                <TextView
                    android:id="@+id/txtEjemploMetodos"
                    style="@style/EtiquetaEjemplo"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/listaMetodos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cómo pagar" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Escanea el QR con la app del banco o billetera.\n2. Verifica la llave Bre-B y el número de cuenta.\n3. Confirma el valor y guarda el comprobante."
                    android:textColor="@color/texto"
                    android:textSize="17sp"
                    android:lineSpacingExtra="5dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
