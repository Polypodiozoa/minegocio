<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include layout="@layout/barra_superior" />

    <ScrollView
android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="22dp">

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSaldoActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/texto_secundario"
                    android:textSize="17sp" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etMonto"
                    android:text="Monto del abono (COP) *" />

                <EditText
                    android:id="@+id/etMonto"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej.: 50000"
                    android:inputType="number" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Forma de pago" />

                <Spinner
                    android:id="@+id/spForma"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/fondo_campo"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:minHeight="56dp" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etNotas"
                    android:text="Notas (opcional)" />

                <EditText
                    android:id="@+id/etNotas"
                    style="@style/CampoMultilinea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej.: abono a la venta del 18 de octubre"
                    android:inputType="textCapSentences|textMultiLine" />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comprobante del abono" />

                <TextView
                    style="@style/Ayuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Puedes tomar una foto del comprobante o subir un documento o imagen." />

                <Button
                    android:id="@+id/btnFoto"
                    style="@style/BotonSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tomar foto del comprobante" />

                <Button
                    android:id="@+id/btnArchivo"
                    style="@style/BotonSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Elegir archivo o imagen" />

                <LinearLayout
                    android:id="@+id/containerAdjuntos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:elevation="8dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btnGuardar"
            style="@style/BotonPrimario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar abono" />
    </LinearLayout>
</LinearLayout>
