<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include layout="@layout/barra_superior" />

    <ScrollView
android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="22dp">

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Foto" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgPersona"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:background="@drawable/fondo_foto"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_persona"
                        android:contentDescription="Foto" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnTomarFoto"
                            style="@style/BotonSecundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:text="Tomar foto" />

                        <Button
                            android:id="@+id/btnElegirFoto"
                            style="@style/BotonSecundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="52dp"
                            android:text="Elegir archivo" />

                        <Button
                            android:id="@+id/btnQuitarFoto"
                            style="@style/BotonTexto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Quitar foto"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Datos" />

                <TextView
                    android:id="@+id/lblNombre"
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etNombre"
                    android:text="Nombre completo *" />

                <EditText
                    android:id="@+id/etNombre"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej.: María Fernanda Gómez"
                    android:inputType="textCapWords" />

                <TextView
                    android:id="@+id/lblContacto"
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etContacto"
                    android:text="Persona de contacto"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/etContacto"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej.: Jorge Ruiz"
                    android:inputType="textCapWords"
                    android:visibility="gone" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etTelefono"
                    android:text="Teléfono o WhatsApp" />

                <EditText
                    android:id="@+id/etTelefono"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej.: 310 555 2211"
                    android:inputType="phone" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etCorreo"
                    android:text="Correo electrónico (opcional)" />

                <EditText
                    android:id="@+id/etCorreo"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej.: nombre@correo.com"
                    android:inputType="textEmailAddress" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etDireccion"
                    android:text="Dirección (opcional)" />

                <EditText
                    android:id="@+id/etDireccion"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej.: Calle 45 #12-30, Bogotá"
                    android:inputType="textPostalAddress" />

                <TextView
                    android:id="@+id/lblCupo"
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etCupo"
                    android:text="Cupo de fiado (COP)" />

                <EditText
                    android:id="@+id/etCupo"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0 = sin límite"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/ayudaCupo"
                    style="@style/Ayuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Máximo que puedes fiar a este cliente. La app avisa si una venta a crédito supera el cupo." />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etNotas"
                    android:text="Notas (opcional)" />

                <EditText
                    android:id="@+id/etNotas"
                    style="@style/CampoMultilinea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Preferencias, acuerdos de pago, observaciones…"
                    android:inputType="textCapSentences|textMultiLine" />
            </LinearLayout>

            <Button
                android:id="@+id/btnEliminar"
                style="@style/BotonPeligro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eliminar"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:elevation="8dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btnGuardar"
            style="@style/BotonPrimario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar" />
    </LinearLayout>
</LinearLayout>
