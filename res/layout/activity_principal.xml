<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/scrollForm" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/primario"
            android:paddingLeft="20dp"
            android:paddingRight="14dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTituloApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mi Negocio"
                    android:textColor="@color/blanco"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#D8E8F0"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtNegocio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#E6F1F6"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDatos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minHeight="52dp"
                android:minWidth="52dp"
                android:maxWidth="120dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="@drawable/fondo_boton_usuario"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_qr"
                android:drawableTint="@color/blanco"
                android:drawablePadding="6dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="Datos"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minHeight="52dp"
                android:minWidth="52dp"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="@drawable/fondo_boton_usuario"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_persona"
                android:drawableTint="@color/blanco"
                android:drawablePadding="6dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Usuario"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="16dp">

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumen de hoy" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/celdaVentasHoy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ventas de hoy"
                            android:textColor="@color/texto_secundario"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtVentasHoy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="$ 0"
                            android:textColor="@color/texto"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/celdaVentasMes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ventas del mes"
                            android:textColor="@color/texto_secundario"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtVentasMes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="$ 0"
                            android:textColor="@color/texto"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/celdaUtilidad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Utilidad del mes"
                            android:textColor="@color/texto_secundario"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtUtilidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="$ 0"
                            android:textColor="@color/texto"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/celdaPorCobrar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Por cobrar"
                            android:textColor="@color/texto_secundario"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtPorCobrar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="$ 0"
                            android:textColor="@color/texto"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAlerta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/fondo_alerta"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_alerta"
                    android:tint="@color/advertencia"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/txtAlerta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/advertencia"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardDeudas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/fondo_alerta"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_alerta"
                    android:tint="@color/error"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/txtDeudas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/error"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="¿Qué quieres hacer?" />

            <GridLayout
                android:id="@+id/gridAcciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Últimas ventas" />

                <LinearLayout
                    android:id="@+id/listaRecientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnVerVentas"
                    style="@style/BotonTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ver todas las ventas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardBienvenida"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Empieza en 3 pasos" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Agrega tus productos y su existencia.\n2. Registra una venta y elige el cliente.\n3. Revisa tus informes cuando quieras."
                    android:textColor="@color/texto"
                    android:textSize="17sp"
                    android:lineSpacingExtra="4dp" />

                <Button
                    android:id="@+id/btnPrimerProducto"
                    style="@style/BotonPrimario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Agregar mi primer producto" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardRespaldo"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Protege tu información" />

                <TextView
                    android:id="@+id/txtRespaldo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Última copia: nunca."
                    android:textColor="@color/texto"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnCopia"
                    style="@style/BotonSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Crear copia de seguridad" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
