<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include layout="@layout/barra_superior" />

    <ScrollView
android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="22dp">

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Foto del producto" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgProducto"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:background="@drawable/fondo_foto"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_caja"
                        android:contentDescription="Foto del producto" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnTomarFoto"
                            style="@style/BotonSecundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:text="Tomar foto" />

                        <Button
                            android:id="@+id/btnElegirFoto"
                            style="@style/BotonSecundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="52dp"
                            android:text="Elegir archivo" />

                        <Button
                            android:id="@+id/btnQuitarFoto"
                            style="@style/BotonTexto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Quitar foto"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Datos del producto" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etNombre"
                    android:text="Nombre del producto * · ej. Caja de lápices x12" />

                <EditText
                    android:id="@+id/etNombre"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etCategoria"
                    android:text="Categoría · ej. Papelería, Joyería, Alimentos" />

                <EditText
                    android:id="@+id/etCategoria"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etCodigo"
                    android:text="Código o referencia · ej. LAP-012" />

                <EditText
                    android:id="@+id/etCodigo"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

                <Button
                    android:id="@+id/btnEscanearCodigo"
                    style="@style/BotonSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Escanear código de barras o QR" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etUnidad"
                    android:text="Unidad de venta (unidad, caja, docena…)" />

                <EditText
                    android:id="@+id/etUnidad"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Precios y existencias" />

                <TextView
                    style="@style/Ayuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Todos los precios se manejan en pesos colombianos. Escribe solo números." />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etPrecio"
                    android:text="Precio de venta (COP) * · ej. 12500" />

                <EditText
                    android:id="@+id/etPrecio"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etCosto"
                    android:text="Costo de compra (COP) · ej. 7000" />

                <EditText
                    android:id="@+id/etCosto"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

                <TextView
                    style="@style/Ayuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="El costo se usa para calcular la utilidad de cada venta." />

                <TextView
                    android:id="@+id/txtGananciaUnidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/exito"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etStock"
                    android:text="Existencias actuales · ej. 10" />

                <EditText
                    android:id="@+id/etStock"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etStockMinimo"
                    android:text="Avisar cuando queden menos de · ej. 3" />

                <EditText
                    android:id="@+id/etStockMinimo"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:labelFor="@+id/etImpuestoProducto"
                    android:text="IVA propio de este producto (Vacío = usa el IVA general)" />

                <EditText
                    android:id="@+id/etImpuestoProducto"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />

                <TextView
                    style="@style/Ayuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Déjalo vacío para cobrar el IVA general de Ajustes. Escríbelo (19, 5, 0…) solo si este producto tiene una tarifa distinta." />

                <Switch
                    android:id="@+id/swVence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="48dp"
                    android:text="Controlar vencimiento" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etDiasAviso"
                    android:text="Avisar cuántos días antes (30)" />

                <EditText
                    android:id="@+id/etDiasAviso"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardLotes"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lotes en existencia" />

                <TextView
                    style="@style/Ayuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cada compra entra con su propio costo. Aquí ves cuánto queda de cada precio." />

                <LinearLayout
                    android:id="@+id/containerLotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardHistorialPrecio"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Movimiento del precio de compra" />

                <TextView
                    style="@style/Ayuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lo que has pagado por este producto en cada pedido, con la variación frente a la compra anterior." />

                <LinearLayout
                    android:id="@+id/containerPrecioGrafica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/containerPrecios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <Button
                android:id="@+id/btnEliminar"
                style="@style/BotonPeligro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Eliminar producto"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:elevation="8dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btnGuardar"
            style="@style/BotonPrimario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar producto" />
    </LinearLayout>
</LinearLayout>
