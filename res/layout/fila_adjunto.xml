<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/superficie"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/imgAdjunto"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/fondo_foto"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_documento"
        android:contentDescription="Vista previa del comprobante" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNombreAdjunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:maxLines="2"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/txtTipoAdjunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnAbrirAdjunto"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_documento"
        android:tint="@color/primario"
        android:contentDescription="Abrir comprobante" />

    <ImageButton
        android:id="@+id/btnQuitarAdjunto"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_basura"
        android:tint="@color/error"
        android:contentDescription="Quitar comprobante" />
</LinearLayout>
