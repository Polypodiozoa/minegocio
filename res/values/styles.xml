<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Tema" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primario</item>
        <item name="android:colorPrimaryDark">@color/primario_oscuro</item>
        <item name="android:colorAccent">@color/primario</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/primario_oscuro</item>
        <item name="android:navigationBarColor">@color/superficie</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Tarjeta">
        <item name="android:background">@drawable/fondo_tarjeta</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="TituloSeccion">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Etiqueta">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Ayuda">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="Campo">
        <item name="android:background">@drawable/fondo_campo</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="CampoMultilinea" parent="Campo">
        <item name="android:singleLine">false</item>
        <item name="android:gravity">top|start</item>
        <item name="android:minHeight">96dp</item>
    </style>

    <style name="BotonPrimario">
        <item name="android:background">@drawable/boton_primario</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="BotonSecundario" parent="BotonPrimario">
        <item name="android:background">@drawable/boton_secundario</item>
        <item name="android:textColor">@color/primario</item>
    </style>

    <style name="BotonPeligro" parent="BotonPrimario">
        <item name="android:background">@drawable/boton_peligro</item>
        <item name="android:textColor">@color/blanco</item>
    </style>

    <style name="BotonTexto">
        <item name="android:background">@drawable/boton_texto</item>
        <item name="android:textColor">@color/primario</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="Valor">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="ValorGrande">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="ValorMedio">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="EstadoBadge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Separador">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/borde</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="TextoLista">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/texto</item>
    </style>

</resources>
